cff-version: 1.2.0
message: "If you use this analysis code, please cite it as below."
title: "Analysis code for: Genomics of Educational Attainment Across 80 Years of Social and Political Transformation in Germany"
abstract: "Analysis pipeline for a gene-by-environment study of educational attainment and intergenerational educational mobility across four German cohorts (BASE-II, SHIP, SOEP, TwinLife), covering individuals born between 1918 and 1995."
type: software
license: MIT
version: "1.0-preprint"
repository-code: "https://github.com/denizFraemke/GxE-education-germany"
